rules_version = '2';

// Stash — Firestore security rules.
//
// Two kinds of account:
//   • Parents belong to a "household". A household's members (parents)
//     can read and write everything under it.
//   • Children sign in with a username. A child can only ever read
//     their OWN child record, their OWN chores and redemptions, and the
//     family's rewards — never another child's data or the parent tools.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each parent's own profile (holds their householdId).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Maps a child's auth account -> { householdId, childId }.
    // The child reads their own; a parent of that household manages it.
    match /childAuth/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId)/members/$(request.auth.uid));
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/households/$(resource.data.householdId)/members/$(request.auth.uid));
    }

    match /households/{hid} {
      function isMember() {
        return request.auth != null
          && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
      }
      // The child record this signed-in child owns (via their mapping).
      function myChildId() {
        return get(/databases/$(database)/documents/childAuth/$(request.auth.uid)).data.childId;
      }
      // Is the caller a child who belongs to THIS household?
      function isChildHere() {
        return request.auth != null
          && exists(/databases/$(database)/documents/childAuth/$(request.auth.uid))
          && get(/databases/$(database)/documents/childAuth/$(request.auth.uid)).data.householdId == hid;
      }

      // The household document itself.
      allow read: if isMember();
      allow create: if request.auth != null; // start a new family
      allow update: if isMember();
      allow delete: if false;

      // Parents in the household. You join by creating your own member
      // doc (you must know the family code, which is the household id,
      // and the household must already exist).
      match /members/{memberId} {
        allow read: if isMember();
        allow create: if request.auth != null
          && request.auth.uid == memberId
          && exists(/databases/$(database)/documents/households/$(hid));
        allow update, delete: if request.auth != null && request.auth.uid == memberId;
      }

      // Children — members manage them; a child may read only their own
      // record, and change only their own colour.
      match /children/{id} {
        allow read, write: if isMember();
        allow read: if isChildHere() && id == myChildId();
        allow update: if isChildHere() && id == myChildId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['color']);
      }

      // Chores — members manage them. A child may read their own chores
      // and mark one done (state -> "pending"); they can't reassign it,
      // change its value, or verify it themselves.
      match /chores/{id} {
        allow read, write: if isMember();
        allow read: if isChildHere() && resource.data.childId == myChildId();
        allow update: if isChildHere()
          && resource.data.childId == myChildId()
          && request.resource.data.childId == resource.data.childId
          && request.resource.data.state == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'award']);
      }

      // Rewards — members manage them; any child in the family may read
      // them (the shop filters by age/child on the client).
      match /rewards/{id} {
        allow read, write: if isMember();
        allow read: if isChildHere();
      }

      // Redemptions — members see all; a child may read and create only
      // their own.
      match /redemptions/{id} {
        allow read, write: if isMember();
        allow read: if isChildHere() && resource.data.childId == myChildId();
        allow create: if isChildHere() && request.resource.data.childId == myChildId();
      }
    }

    // Anything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
