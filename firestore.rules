rules_version = '2';

// Stash — Firestore security rules.
// Phase 1: parent accounts only. A signed-in user can read and write
// their own profile document, and nothing else. (More rules are added
// as the family data and child logins move into the cloud.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Each parent's own profile: only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is locked until later phases add explicit rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
